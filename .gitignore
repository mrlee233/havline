bin/
.data/
web/node_modules/
web/dist/
cmd/havline/web/dist/
dist/
*.db
/data/
# 会话密钥等本地环境变量（.env.example 这类模板可以照常入库）
.env
.env.local
.DS_Store
.cursor/
.playwright-cli/
output/
# Windows 本地构建产物不入库（历史上误提交过 havline-agent.exe，10MB 级二进制）
*.exe
# 项目文档（方案 / 手册 / 截图）只保留在本地，不入版本库、不推送
# 例外：随仓库分发的示例可在取消忽略后单独跟踪
/docs/
web/public/111favicon.png
web/src/assets/brand/logo00.png
# scripts/ 下的本地辅助脚本不入库，但随仓库分发的 agent 安装脚本需要跟踪
scripts/*
!scripts/agent-install.sh
!scripts/build-linux.ps1
!scripts/havline-install.sh
!scripts/upgrade.sh
!scripts/upgrade-hub.sh
!scripts/push-oci-manual.ps1
# 本地压缩包与导出产物不入库（如 web/src.rar）
*.rar
*.zip
*.7z
*.tar.gz
*.log
# 前端 UI 原型（HTML 草稿与截图，约 2.8MB）：只作设计参考，不是构建输入
/prototype/
# 只保留 npm 一份 lockfile：仓库里曾同时存在 pnpm-lock.yaml，
# 两份锁文件各自记录不同版本，装出哪个依赖取决于用哪个包管理器，容易排查不清
web/pnpm-lock.yaml
